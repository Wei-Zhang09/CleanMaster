<Window x:Class="CleanMaster.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CleanMaster" Height="750" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F0F2F5"
        ResizeMode="CanResizeWithGrip"
        Icon="Resources/Icons/bebb7fbb3f23d2157e1ecc8224686535.ico">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16,20,16,28">
                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,6,0,0" Text="{Binding Lang[AppTitle]}"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top">
                    <RadioButton Style="{StaticResource NavBtn}" IsChecked="True" Command="{Binding NavigateCommand}" CommandParameter="Clean">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Lang[NavClean]}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavBtn}" Command="{Binding NavigateCommand}" CommandParameter="LargeFiles">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Lang[NavLargeFiles]}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavBtn}" Command="{Binding NavigateCommand}" CommandParameter="Software">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Lang[NavSoftware]}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavBtn}" Command="{Binding NavigateCommand}" CommandParameter="Startup">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Lang[NavStartup]}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavBtn}" Command="{Binding NavigateCommand}" CommandParameter="LargeFolders">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0"/>
                            <TextBlock Text="大文件夹扫描"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavBtn}" Command="{Binding NavigateCommand}" CommandParameter="DiskAnalysis">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9F9;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0"/>
                            <TextBlock Text="磁盘分析"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavBtn}" Command="{Binding NavigateCommand}" CommandParameter="SystemCleanup">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74C;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0"/>
                            <TextBlock Text="系统清理"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavBtn}" Command="{Binding NavigateCommand}" CommandParameter="Guide">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE82F;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0"/>
                            <TextBlock Text="使用指南"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavBtn}" Command="{Binding NavigateCommand}" CommandParameter="Settings">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Lang[NavSettings]}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavBtn}" Command="{Binding NavigateCommand}" CommandParameter="FollowAuthor">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0"/>
                            <TextBlock Text="关注作者"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavBtn}" Command="{Binding NavigateCommand}" CommandParameter="Donate">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEB51;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0"/>
                            <TextBlock Text="打赏作者"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- License Status (hidden - code preserved) -->
                <Border DockPanel.Dock="Bottom" Margin="12,0,12,8" Padding="12" CornerRadius="8" Background="#1E293B" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Ellipse Width="8" Height="8" Margin="0,0,6,0" Fill="#10B981"/>
                            <TextBlock FontSize="11" Foreground="#94A3B8" Text="{Binding LicenseStatusText}"/>
                        </StackPanel>
                        <Button Command="{Binding ShowActivationCommand}" Margin="0,8,0,0" HorizontalAlignment="Stretch">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#6366F1"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="Padding" Value="0,6"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="立即激活"/>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Disk Info -->
                <Border DockPanel.Dock="Bottom" Margin="12" Padding="14" CornerRadius="8" Background="#1E293B">
                    <StackPanel>
                        <TextBlock Text="C:" FontSize="11" Foreground="#64748B"/>
                        <TextBlock FontSize="20" FontWeight="Bold" Foreground="White" Text="{Binding DiskFreeText}" Margin="0,4,0,8"/>
                        <Grid Height="5" Background="#334155" ClipToBounds="True">
                            <Border HorizontalAlignment="Left" Background="{StaticResource PrimaryBrush}" CornerRadius="3">
                                <Border.RenderTransform><ScaleTransform ScaleX="{Binding DiskUsedPercent}" CenterX="0"/></Border.RenderTransform>
                            </Border>
                        </Grid>
                        <TextBlock FontSize="10" Foreground="#64748B" Margin="0,4,0,0" Text="{Binding DiskUsageText}"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- Clean -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding CurrentView, Converter={StaticResource ViewVisibilityConverter}, ConverterParameter=Clean}">
            <StackPanel Margin="28,20,28,28">
                <Grid Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock FontSize="24" FontWeight="Bold" Foreground="#1E293B" Text="{Binding Clean.Lang[CleanTitle]}"/>
                        <TextBlock Text="{Binding Clean.StatusText}" FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button Style="{StaticResource Btn}" Margin="0,0,8,0" Command="{Binding Clean.ScanCommand}" IsEnabled="{Binding Clean.CanScan}" Content="{Binding Clean.Lang[Scan]}"/>
                        <Button Style="{StaticResource SuccessBtn}" Command="{Binding Clean.CleanCommand}" IsEnabled="{Binding Clean.CanClean}" Content="{Binding Clean.Lang[Clean]}"/>
                    </StackPanel>
                </Grid>

                <Border Height="3" CornerRadius="2" Background="#E2E8F0" Margin="0,0,0,18" Visibility="{Binding Clean.IsScanning, Converter={StaticResource BoolVisibilityConverter}}">
                    <Border HorizontalAlignment="Left" CornerRadius="2" Background="{StaticResource PrimaryBrush}">
                        <Border.Width><MultiBinding StringFormat="{}{0}"><Binding Path="Clean.ProgressPercent"/></MultiBinding></Border.Width>
                    </Border>
                </Border>

                <!-- Clean Progress -->
                <Border Margin="0,0,0,18" Visibility="{Binding Clean.IsCleanProgressVisible, Converter={StaticResource BoolVisibilityConverter}}">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="正在清理..." FontSize="12" Foreground="#64748B"/>
                            <TextBlock Text="{Binding Clean.CleanProgressText}" FontSize="12" Foreground="#64748B" HorizontalAlignment="Right"/>
                        </Grid>
                        <Border Height="6" CornerRadius="3" Background="#E2E8F0">
                            <Border HorizontalAlignment="Left" CornerRadius="3" Background="#10B981">
                                <Border.Width><MultiBinding StringFormat="{}{0}"><Binding Path="Clean.CleanProgressPercent"/></MultiBinding></Border.Width>
                            </Border>
                        </Border>
                        <TextBlock Text="{Binding Clean.CleanCurrentFile}" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <WrapPanel Margin="0,0,0,20">
                    <Border Style="{StaticResource Card}" Margin="0,0,12,0" MinWidth="160">
                        <StackPanel>
                            <TextBlock FontSize="11" Foreground="#94A3B8" Text="{Binding Clean.Lang[ItemsFound]}"/>
                            <TextBlock FontSize="24" FontWeight="Bold" Foreground="#1E293B" Text="{Binding Clean.TotalItemCount}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,12,0" MinWidth="160">
                        <StackPanel>
                            <TextBlock FontSize="11" Foreground="#94A3B8" Text="{Binding Clean.Lang[CleanableSize]}"/>
                            <TextBlock FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Text="{Binding Clean.TotalCleanableText}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" MinWidth="160">
                        <StackPanel>
                            <TextBlock FontSize="11" Foreground="#94A3B8" Text="{Binding Clean.Lang[Categories]}"/>
                            <TextBlock FontSize="24" FontWeight="Bold" Foreground="#1E293B" Text="{Binding Clean.ScanResults.Count}"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <ItemsControl ItemsSource="{Binding Clean.ScanResults}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="0">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="18,0,0,0"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,14,0,14">
                                            <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B"/>
                                                <TextBlock FontSize="11" Foreground="#94A3B8" Text="{Binding ItemCount, StringFormat='{}{0} items'}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Border Grid.Column="2" CornerRadius="4" Padding="8,3" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#DCFCE7"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Items[0].Safety}" Value="Caution"><Setter Property="Background" Value="#FEF9C3"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Items[0].Safety}" Value="Dangerous"><Setter Property="Background" Value="#FEE2E2"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="10" FontWeight="Medium">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Safe"/><Setter Property="Foreground" Value="#16A34A"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Items[0].Safety}" Value="Caution"><Setter Property="Text" Value="Caution"/><Setter Property="Foreground" Value="#CA8A04"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding Items[0].Safety}" Value="Dangerous"><Setter Property="Text" Value="Danger"/><Setter Property="Foreground" Value="#DC2626"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <TextBlock Grid.Column="3" Text="{Binding TotalSizeText}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <ToggleButton Grid.Column="4" IsChecked="{Binding IsExpanded}" Margin="0,0,18,0" Cursor="Hand">
                                            <ToggleButton.Style>
                                                <Style TargetType="ToggleButton">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Padding" Value="4"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ToggleButton">
                                                                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                                    <TextBlock x:Name="ArrowIcon" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#64748B"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsChecked" Value="True">
                                                                        <Setter TargetName="ArrowIcon" Property="Text" Value="&#xE70E;"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ToggleButton.Style>
                                        </ToggleButton>
                                    </Grid>

                                    <!-- Expanded file list -->
                                    <ItemsControl ItemsSource="{Binding Items}" Visibility="{Binding IsExpanded, Converter={StaticResource BoolVisibilityConverter}}" Margin="18,0,18,14">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,2" Background="#F8FAFC" Padding="8,4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Name}" FontSize="11" Foreground="#1E293B"/>
                                                            <TextBlock Text="{Binding FullPath}" FontSize="9" Foreground="#94A3B8" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <Border Grid.Column="2" CornerRadius="3" Padding="4,1" Background="#E2E8F0" Margin="8,0">
                                                            <TextBlock Text="{Binding SoftwareInfo}" FontSize="9" Foreground="#64748B"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Style="{StaticResource Card}" Margin="0,10,0,0" Visibility="{Binding Clean.LastCleanResult, Converter={StaticResource NullVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{StaticResource SuccessBrush}" Margin="0,0,10,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" Text="{Binding Clean.Lang[LastCleanup]}"/>
                            <TextBlock Text="{Binding Clean.CleanResultText}" FontSize="11" Foreground="#64748B"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Large Files -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding CurrentView, Converter={StaticResource ViewVisibilityConverter}, ConverterParameter=LargeFiles}">
            <StackPanel Margin="28,20,28,28">
                <Grid Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock FontSize="24" FontWeight="Bold" Foreground="#1E293B" Text="{Binding DiskFiles.Lang[LargeFilesTitle]}"/>
                        <TextBlock Text="{Binding DiskFiles.LargeFileStatus}" FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <ComboBox ItemsSource="{Binding DiskFiles.DiskDrives}" SelectedItem="{Binding DiskFiles.SelectedDrive}" Width="70" Padding="5,3" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding DiskFiles.Lang[MinSize]}" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#64748B"/>
                        <TextBox Text="{Binding DiskFiles.MinFileSizeInput, UpdateSourceTrigger=PropertyChanged}" Width="70" Padding="5,3"/>
                        <TextBlock Text="MB" VerticalAlignment="Center" Margin="4,0,8,0" Foreground="#64748B"/>
                        <Button Style="{StaticResource Btn}" Margin="8,0,0,0" Command="{Binding DiskFiles.FindLargeFilesCommand}" IsEnabled="{Binding DiskFiles.IsFindingLargeFiles, Converter={StaticResource InverseBoolConverter}}" Content="{Binding DiskFiles.Lang[Search]}"/>
                        <Button Style="{StaticResource DangerBtn}" Margin="8,0,0,0" Command="{Binding DiskFiles.DeleteLargeFilesCommand}" Content="{Binding DiskFiles.Lang[DeleteSelected]}"/>
                    </StackPanel>
                </Grid>

                <ItemsControl ItemsSource="{Binding DiskFiles.LargeFiles}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="6" Padding="14,8" Margin="0,0,0,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}" FontSize="12" FontWeight="Medium" Foreground="#1E293B"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding FileType}" FontSize="10" Foreground="#6366F1" FontWeight="Medium"/>
                                            <TextBlock Text=" | " FontSize="10" Foreground="#CBD5E1"/>
                                            <TextBlock Text="{Binding FileDesc}" FontSize="10" Foreground="#64748B" TextTrimming="CharacterEllipsis" MaxWidth="300"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Grid.Column="2" CornerRadius="4" Padding="6,3" Margin="8,0" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#DCFCE7"/>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding SafetyText}" FontSize="9" FontWeight="Medium">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#16A34A"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SafetyHint}" Value="caution">
                                                            <Setter Property="Foreground" Value="#CA8A04"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SafetyHint}" Value="danger">
                                                            <Setter Property="Foreground" Value="#DC2626"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <TextBlock Grid.Column="3" Text="{Binding LastModified, StringFormat='yyyy-MM-dd'}" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{Binding SizeText}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" MinWidth="70" TextAlignment="Right"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Software -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding CurrentView, Converter={StaticResource ViewVisibilityConverter}, ConverterParameter=Software}">
            <StackPanel Margin="28,20,28,28">
                <Grid Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock FontSize="24" FontWeight="Bold" Foreground="#1E293B" Text="{Binding Software.Lang[SoftwareTitle]}"/>
                        <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding Software.SoftwareStatus}"/>
                    </StackPanel>
                </Grid>

                <!-- Loading Indicator -->
                <Border Margin="0,0,0,20" Visibility="{Binding Software.IsLoadingSoftware, Converter={StaticResource BoolVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" Margin="0,40,0,0">
                        <TextBlock Text="正在扫描已安装软件..." FontSize="14" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                        <TextBlock Text="首次加载可能需要几秒钟" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Software.InstalledSoftware}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="6" Padding="14,10" Margin="0,0,0,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Icon -->
                                    <Image Grid.Column="0" Width="24" Height="24" Margin="0,0,12,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"
                                           Source="{Binding IconPath, Converter={StaticResource IconConverter}}"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium" Foreground="#1E293B"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Publisher}" FontSize="10" Foreground="#94A3B8"/>
                                            <TextBlock Text="{Binding Version}" FontSize="10" Foreground="#94A3B8" Margin="8,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding InstallLocation}" FontSize="9" Foreground="#CBD5E1" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" Visibility="{Binding InstallLocation, Converter={StaticResource NullVisibilityConverter}}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="12,0"/>
                                    <Button Grid.Column="3" Style="{StaticResource DangerBtn}" Padding="12,5" FontSize="11" Command="{Binding DataContext.Software.UninstallCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" CommandParameter="{Binding}">
                                        <TextBlock Text="{Binding DataContext.Lang[Uninstall], RelativeSource={RelativeSource AncestorType=ScrollViewer}}"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Startup -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding CurrentView, Converter={StaticResource ViewVisibilityConverter}, ConverterParameter=Startup}">
            <StackPanel Margin="28,20,28,28">
                <Grid Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock FontSize="24" FontWeight="Bold" Foreground="#1E293B" Text="{Binding Startup.Lang[StartupTitle]}"/>
                        <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding Startup.StartupItems.Count, StringFormat='{}{0} startup items'}"/>
                    </StackPanel>
                </Grid>
                <ItemsControl ItemsSource="{Binding Startup.StartupItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="6" Padding="14,10" Margin="0,0,0,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"
                                           Source="{Binding IconPath, Converter={StaticResource IconConverter}}"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium" Foreground="#1E293B"/>
                                        <TextBlock Text="{Binding Command}" FontSize="10" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" MaxWidth="450"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" CornerRadius="3" Padding="6,2" Background="#F1F5F9" VerticalAlignment="Center" Margin="12,0">
                                        <TextBlock Text="{Binding Source}" FontSize="10" Foreground="#64748B"/>
                                    </Border>
                                    <Button Grid.Column="3" Style="{StaticResource DangerBtn}" Padding="12,5" FontSize="11" Command="{Binding DataContext.Startup.DisableStartupCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" CommandParameter="{Binding}">
                                        <TextBlock Text="{Binding DataContext.Lang[Disable], RelativeSource={RelativeSource AncestorType=ScrollViewer}}"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Large Folders -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding CurrentView, Converter={StaticResource ViewVisibilityConverter}, ConverterParameter=LargeFolders}">
            <StackPanel Margin="28,20,28,28">
                <Grid Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock FontSize="24" FontWeight="Bold" Foreground="#1E293B" Text="大文件夹扫描"/>
                        <TextBlock Text="{Binding DiskFiles.FolderScanStatus}" FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <ComboBox ItemsSource="{Binding DiskFiles.DiskDrives}" SelectedItem="{Binding DiskFiles.SelectedDrive}" Width="70" Padding="5,3" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource Btn}" Command="{Binding DiskFiles.FindLargeFoldersCommand}" IsEnabled="{Binding DiskFiles.IsScanningFolders, Converter={StaticResource InverseBoolConverter}}" Content="扫描"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="扫描占用空间较大的文件夹，帮助您找到空间占用的来源。" FontSize="13" Foreground="#94A3B8" Margin="0,0,0,16"/>
                <ItemsControl ItemsSource="{Binding DiskFiles.LargeFolders}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="6" Padding="14,10" Margin="0,0,0,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding FolderName}" FontSize="13" FontWeight="Medium" Foreground="#1E293B"/>
                                        <TextBlock Text="{Binding FolderPath}" FontSize="10" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" MaxWidth="500"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Description}" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" Margin="12,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" MinWidth="80" TextAlignment="Right"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Empty Folders -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding CurrentView, Converter={StaticResource ViewVisibilityConverter}, ConverterParameter=EmptyFolders}">
            <StackPanel Margin="28,20,28,28">
                <Grid Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock FontSize="24" FontWeight="Bold" Foreground="#1E293B" Text="空文件夹清理"/>
                        <TextBlock Text="{Binding DiskFiles.EmptyFolderStatus}" FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <ComboBox ItemsSource="{Binding DiskFiles.DiskDrives}" SelectedItem="{Binding DiskFiles.SelectedDrive}" Width="70" Padding="5,3" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource Btn}" Margin="0,0,8,0" Command="{Binding DiskFiles.FindEmptyFoldersCommand}" IsEnabled="{Binding DiskFiles.IsScanningEmpty, Converter={StaticResource InverseBoolConverter}}" Content="扫描"/>
                        <Button Style="{StaticResource DangerBtn}" Command="{Binding DiskFiles.DeleteEmptyFoldersCommand}" Content="删除选中"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="扫描并清理空文件夹，保持文件系统整洁。空文件夹不占用空间，但会影响查找效率。" FontSize="13" Foreground="#94A3B8" Margin="0,0,0,16"/>
                <ItemsControl ItemsSource="{Binding DiskFiles.EmptyFolders}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="6" Padding="14,10" Margin="0,0,0,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding FolderName}" FontSize="13" FontWeight="Medium" Foreground="#1E293B"/>
                                        <TextBlock Text="{Binding FolderPath}" FontSize="10" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" MaxWidth="600"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Disk Analysis -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding CurrentView, Converter={StaticResource ViewVisibilityConverter}, ConverterParameter=DiskAnalysis}">
            <StackPanel Margin="28,20,28,28">
                <TextBlock FontSize="24" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,8" Text="磁盘分析"/>
                <TextBlock Text="{Binding Settings.AnalysisStatus}" FontSize="12" Foreground="#64748B" Margin="0,0,0,20"/>

                <Grid Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="选择磁盘:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#64748B"/>
                        <ComboBox ItemsSource="{Binding Settings.AvailableDrives}" SelectedItem="{Binding Settings.AnalyzedDrive}" 
                                  Width="70" Padding="5,3" Margin="0,0,12,0"/>
                        <Button Style="{StaticResource Btn}" Padding="16,8"
                                Command="{Binding Settings.AnalyzeDiskCommand}" IsEnabled="{Binding Settings.IsAnalyzing, Converter={StaticResource InverseBoolConverter}}" Content="开始分析"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="分析磁盘空间占用情况，帮助您了解各类文件的空间占用比例。" FontSize="13" Foreground="#94A3B8" Margin="0,0,0,24"/>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <!-- Space visualization bar -->
                        <Border Height="30" CornerRadius="6" Background="#E2E8F0" Margin="0,0,0,20" ClipToBounds="True">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="{Binding Settings.DiskSpaceCategories[0].Percentage, Converter={StaticResource PercentToWidthConverter}}" Background="{Binding Settings.DiskSpaceCategories[0].Color}" Height="30"/>
                                <Border Width="{Binding Settings.DiskSpaceCategories[1].Percentage, Converter={StaticResource PercentToWidthConverter}}" Background="{Binding Settings.DiskSpaceCategories[1].Color}" Height="30"/>
                                <Border Width="{Binding Settings.DiskSpaceCategories[2].Percentage, Converter={StaticResource PercentToWidthConverter}}" Background="{Binding Settings.DiskSpaceCategories[2].Color}" Height="30"/>
                                <Border Width="{Binding Settings.DiskSpaceCategories[3].Percentage, Converter={StaticResource PercentToWidthConverter}}" Background="{Binding Settings.DiskSpaceCategories[3].Color}" Height="30"/>
                                <Border Width="{Binding Settings.DiskSpaceCategories[4].Percentage, Converter={StaticResource PercentToWidthConverter}}" Background="{Binding Settings.DiskSpaceCategories[4].Color}" Height="30"/>
                            </StackPanel>
                        </Border>

                        <!-- Category list -->
                        <ItemsControl ItemsSource="{Binding Settings.DiskSpaceCategories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="14" Height="14" Fill="{Binding Color}" Margin="0,0,10,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14" Foreground="#1E293B"/>
                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="14" FontWeight="Medium" Foreground="#1E293B" Margin="16,0"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Percentage, StringFormat='{}{0:F1}%'}" FontSize="13" Foreground="#64748B" Width="60" TextAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- System Cleanup -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding CurrentView, Converter={StaticResource ViewVisibilityConverter}, ConverterParameter=SystemCleanup}">
            <StackPanel Margin="28,20,28,28">
                <TextBlock FontSize="24" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,8" Text="系统清理"/>
                <TextBlock Text="{Binding SystemCleanup.CleanupStatus}" FontSize="12" Foreground="#64748B" Margin="0,0,0,12"/>

                <!-- Progress bar -->
                <Border Margin="0,0,0,16" Visibility="{Binding SystemCleanup.IsProgressVisible, Converter={StaticResource BoolVisibilityConverter}}">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="执行进度" FontSize="12" Foreground="#64748B"/>
                            <TextBlock Text="{Binding SystemCleanup.ProgressText}" FontSize="12" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Border Height="8" CornerRadius="4" Background="#E2E8F0">
                            <Border HorizontalAlignment="Left" CornerRadius="4" Background="{StaticResource PrimaryBrush}">
                                <Border.Width>
                                    <MultiBinding StringFormat="{}{0}">
                                        <Binding Path="SystemCleanup.ProgressPercent"/>
                                    </MultiBinding>
                                </Border.Width>
                            </Border>
                        </Border>
                    </StackPanel>
                </Border>

                <TextBlock Text="使用 Windows 内置工具进行深度清理，完全安全可靠。" FontSize="13" Foreground="#94A3B8" Margin="0,0,0,24"/>

                <!-- DISM Cleanup -->
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Windows 组件清理" FontSize="15" FontWeight="SemiBold" Foreground="#1E293B"/>
                            <TextBlock Text="清理旧版本的 Windows 更新组件，通常可释放 1-5GB 空间。" FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
                            <TextBlock Text="安全等级：安全 | 耗时：3-10分钟" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource Btn}" Command="{Binding SystemCleanup.RunDismCleanupCommand}" IsEnabled="{Binding SystemCleanup.IsRunningCleanup, Converter={StaticResource InverseBoolConverter}}" Content="执行清理" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- SFC Scan -->
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="系统文件修复" FontSize="15" FontWeight="SemiBold" Foreground="#1E293B"/>
                            <TextBlock Text="扫描并修复损坏的系统文件，解决系统异常问题。" FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
                            <TextBlock Text="安全等级：安全 | 耗时：5-15分钟" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource Btn}" Command="{Binding SystemCleanup.RunSfcScanCommand}" IsEnabled="{Binding SystemCleanup.IsRunningCleanup, Converter={StaticResource InverseBoolConverter}}" Content="开始扫描" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- DNS Flush -->
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="DNS 缓存清理" FontSize="15" FontWeight="SemiBold" Foreground="#1E293B"/>
                            <TextBlock Text="清理 DNS 解析缓存，解决网页无法访问的问题。" FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
                            <TextBlock Text="安全等级：安全 | 耗时：即时" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource Btn}" Command="{Binding SystemCleanup.FlushDnsCommand}" IsEnabled="{Binding SystemCleanup.IsRunningCleanup, Converter={StaticResource InverseBoolConverter}}" Content="清理" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Registry Cleaner -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding CurrentView, Converter={StaticResource ViewVisibilityConverter}, ConverterParameter=RegistryCleaner}">
            <StackPanel Margin="28,20,28,28">
                <Grid Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock FontSize="24" FontWeight="Bold" Foreground="#1E293B" Text="注册表清理"/>
                        <TextBlock Text="{Binding RegistryCleaner.StatusText}" FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button Style="{StaticResource Btn}" Margin="0,0,8,0" Command="{Binding RegistryCleaner.ScanCommand}" IsEnabled="{Binding RegistryCleaner.IsScanning, Converter={StaticResource InverseBoolConverter}}" Content="扫描"/>
                        <Button Style="{StaticResource DangerBtn}" Command="{Binding RegistryCleaner.CleanCommand}" IsEnabled="{Binding RegistryCleaner.IsScanning, Converter={StaticResource InverseBoolConverter}}" Content="清理选中"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="扫描并清理无效的注册表项，提升系统稳定性。清理前会自动备份。" FontSize="13" Foreground="#94A3B8" Margin="0,0,0,16"/>

                <ItemsControl ItemsSource="{Binding RegistryCleaner.Issues}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="6" Padding="14,10" Margin="0,0,0,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" CornerRadius="4" Padding="6,3" Margin="0,0,12,0" Background="#FEE2E2">
                                        <TextBlock Text="{Binding Type}" FontSize="10" FontWeight="Medium" Foreground="#DC2626"/>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium" Foreground="#1E293B"/>
                                        <TextBlock Text="{Binding Description}" FontSize="10" Foreground="#94A3B8" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Key}" FontSize="9" Foreground="#CBD5E1" VerticalAlignment="Center" MaxWidth="200" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Privacy Cleaner -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding CurrentView, Converter={StaticResource ViewVisibilityConverter}, ConverterParameter=PrivacyCleaner}">
            <StackPanel Margin="28,20,28,28">
                <Grid Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock FontSize="24" FontWeight="Bold" Foreground="#1E293B" Text="隐私清理"/>
                        <TextBlock Text="{Binding PrivacyCleaner.StatusText}" FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button Style="{StaticResource Btn}" Margin="0,0,8,0" Command="{Binding PrivacyCleaner.ScanCommand}" IsEnabled="{Binding PrivacyCleaner.IsScanning, Converter={StaticResource InverseBoolConverter}}" Content="扫描"/>
                        <Button Style="{StaticResource DangerBtn}" Command="{Binding PrivacyCleaner.CleanCommand}" IsEnabled="{Binding PrivacyCleaner.IsScanning, Converter={StaticResource InverseBoolConverter}}" Content="清理选中"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="清理浏览记录、最近文档、搜索历史等隐私数据，保护个人隐私。" FontSize="13" Foreground="#94A3B8" Margin="0,0,0,16"/>

                <ItemsControl ItemsSource="{Binding PrivacyCleaner.Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="6" Padding="14,10" Margin="0,0,0,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" CornerRadius="4" Padding="6,3" Margin="0,0,12,0" Background="#FEF9C3">
                                        <TextBlock Text="{Binding Type}" FontSize="10" FontWeight="Medium" Foreground="#CA8A04"/>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium" Foreground="#1E293B"/>
                                        <TextBlock Text="{Binding Description}" FontSize="10" Foreground="#94A3B8"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Path}" FontSize="9" Foreground="#CBD5E1" VerticalAlignment="Center" MaxWidth="250" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Guide -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding CurrentView, Converter={StaticResource ViewVisibilityConverter}, ConverterParameter=Guide}">
            <StackPanel Margin="28,20,28,28" MaxWidth="700">
                <TextBlock FontSize="24" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,24" Text="使用指南"/>

                <!-- Safety Levels -->
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,12" Text="安全等级说明"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="4" Padding="8,3" Background="#DCFCE7" Margin="0,0,12,0">
                                <TextBlock Text="安全" FontSize="11" FontWeight="Medium" Foreground="#16A34A"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="删除不影响系统和软件正常运行，数据可自动重建" FontSize="13" Foreground="#64748B"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="4" Padding="8,3" Background="#FEF9C3" Margin="0,0,12,0">
                                <TextBlock Text="谨慎" FontSize="11" FontWeight="Medium" Foreground="#CA8A04"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="删除前请确认内容，可能包含有用数据" FontSize="13" Foreground="#64748B"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="4" Padding="8,3" Background="#FEE2E2" Margin="0,0,12,0">
                                <TextBlock Text="危险" FontSize="11" FontWeight="Medium" Foreground="#DC2626"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="删除可能导致系统异常，请勿轻易删除" FontSize="13" Foreground="#64748B"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Disk Cleanup -->
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,8" Text="磁盘清理"/>
                        <TextBlock Text="扫描并清理系统中的垃圾文件，包括临时文件、缓存、日志等。" FontSize="13" Foreground="#64748B" Margin="0,0,0,8"/>
                        <TextBlock Text="扫描范围：" FontSize="13" FontWeight="Medium" Foreground="#1E293B" Margin="0,0,0,4"/>
                        <TextBlock Text="- 回收站（安全）" FontSize="13" Foreground="#64748B"/>
                        <TextBlock Text="- Windows 临时文件（安全）" FontSize="13" Foreground="#64748B"/>
                        <TextBlock Text="- Windows 更新缓存（安全）" FontSize="13" Foreground="#64748B"/>
                        <TextBlock Text="- 浏览器缓存：Chrome、Edge、Firefox、Brave、Opera 等（安全）" FontSize="13" Foreground="#64748B"/>
                        <TextBlock Text="- 开发工具缓存：VS Code、Docker、JetBrains、npm、pip 等（安全）" FontSize="13" Foreground="#64748B"/>
                        <TextBlock Text="- 应用缓存：QQ、微信、腾讯视频、爱奇艺、哔哩哔哩、抖音等（安全）" FontSize="13" Foreground="#64748B"/>
                        <TextBlock Text="- 日志文件、崩溃转储（安全）" FontSize="13" Foreground="#64748B"/>
                        <TextBlock Text="" FontSize="8"/>
                        <TextBlock Text="提示：点击分类右侧的箭头可展开查看详细文件列表" FontSize="12" Foreground="#3B82F6"/>
                    </StackPanel>
                </Border>

                <!-- Large Files -->
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,8" Text="大文件查找"/>
                        <TextBlock Text="扫描磁盘中占用空间较大的文件，支持设置最小文件大小。" FontSize="13" Foreground="#64748B" Margin="0,0,0,8"/>
                        <TextBlock Text="每个文件都会显示类型和安全提示，帮助您判断是否可以删除。" FontSize="13" Foreground="#64748B"/>
                    </StackPanel>
                </Border>

                <!-- Software Management -->
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,8" Text="软件管理"/>
                        <TextBlock Text="查看已安装的软件并卸载，自动清理残留文件和注册表。" FontSize="13" Foreground="#64748B" Margin="0,0,0,8"/>
                        <TextBlock Text="卸载后会自动扫描残留文件夹和注册表项，推荐一并清理。" FontSize="13" Foreground="#64748B"/>
                    </StackPanel>
                </Border>

                <!-- Startup Management -->
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,8" Text="启动项管理"/>
                        <TextBlock Text="管理开机自启动的程序，禁用不需要的启动项可加快开机速度。" FontSize="13" Foreground="#64748B" Margin="0,0,0,8"/>
                        <TextBlock Text="支持从注册表和启动文件夹两个位置管理启动项。" FontSize="13" Foreground="#64748B"/>
                    </StackPanel>
                </Border>

                <!-- Large Folders -->
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,8" Text="大文件夹扫描"/>
                        <TextBlock Text="扫描占用空间较大的文件夹，帮助您找到空间占用的来源。" FontSize="13" Foreground="#64748B" Margin="0,0,0,8"/>
                        <TextBlock Text="适合在大文件查找无法找到足够空间时使用，许多小文件聚集也会占用大量空间。" FontSize="13" Foreground="#64748B"/>
                    </StackPanel>
                </Border>

                <!-- Disk Analysis -->
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,8" Text="磁盘分析"/>
                        <TextBlock Text="分析磁盘空间占用情况，帮助您了解各类文件的空间占用比例。" FontSize="13" Foreground="#64748B" Margin="0,0,0,8"/>
                        <TextBlock Text="分析内容包括：" FontSize="13" FontWeight="Medium" Foreground="#1E293B" Margin="0,0,0,4"/>
                        <TextBlock Text="- Windows 系统文件" FontSize="13" Foreground="#64748B"/>
                        <TextBlock Text="- Program Files 程序文件" FontSize="13" Foreground="#64748B"/>
                        <TextBlock Text="- 用户数据文件" FontSize="13" Foreground="#64748B"/>
                        <TextBlock Text="- 其他文件" FontSize="13" Foreground="#64748B"/>
                    </StackPanel>
                </Border>

                <!-- System Cleanup -->
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,8" Text="系统清理"/>
                        <TextBlock Text="使用 Windows 内置工具进行深度清理，完全安全可靠。" FontSize="13" Foreground="#64748B" Margin="0,0,0,8"/>
                        <TextBlock Text="- Windows 组件清理：删除旧版本更新文件（安全，1-5GB）" FontSize="13" Foreground="#64748B"/>
                        <TextBlock Text="- 系统文件修复：扫描修复损坏的系统文件（安全）" FontSize="13" Foreground="#64748B"/>
                        <TextBlock Text="- DNS 缓存清理：重置域名解析缓存（安全）" FontSize="13" Foreground="#64748B"/>
                        <TextBlock Text="" FontSize="8"/>
                        <TextBlock Text="注意：系统清理功能需要管理员权限" FontSize="12" Foreground="#F59E0B"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Settings -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding CurrentView, Converter={StaticResource ViewVisibilityConverter}, ConverterParameter=Settings}">
            <StackPanel Margin="28,20,28,28">
                <TextBlock FontSize="24" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,24" Text="{Binding Settings.Lang[SettingsTitle]}"/>

                <!-- Language -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,16" Text="{Binding Settings.Lang[Language]}"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Margin="0,0,24,0" IsChecked="{Binding Settings.IsChinese}" GroupName="Lang">
                                <TextBlock Text="中文" FontSize="14"/>
                            </RadioButton>
                            <RadioButton IsChecked="{Binding Settings.IsChinese, Converter={StaticResource InverseBoolConverter}}" GroupName="Lang">
                                <TextBlock Text="English" FontSize="14"/>
                            </RadioButton>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Website Info -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,12" Text="官方网站"/>
                        <TextBlock FontSize="13" Foreground="#64748B" TextWrapping="Wrap" Text="如官方网站无法访问，请通过抖音或B站联系作者获取最新地址。"/>
                    </StackPanel>
                </Border>

                <!-- About -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,12" Text="{Binding Settings.Lang[About]}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,10,0"/>
                            <TextBlock FontSize="18" FontWeight="Bold" Foreground="#1E293B" Text="{Binding Settings.Lang[AppTitle]}"/>
                        </StackPanel>
                        <TextBlock FontSize="12" Foreground="#64748B" Text="{Binding Settings.Lang[Version]}"/>
                        <TextBlock FontSize="12" Foreground="#64748B" Margin="0,4,0,0" Text="{Binding Settings.Lang[Description]}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Follow Author -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding CurrentView, Converter={StaticResource ViewVisibilityConverter}, ConverterParameter=FollowAuthor}">
            <StackPanel Margin="28,20,28,28">
                <TextBlock FontSize="24" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,20" Text="关注作者"/>

                <Border Style="{StaticResource Card}" Padding="24">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#1E293B" TextAlignment="Center" Margin="0,0,0,8" Text="关注作者"/>
                        <TextBlock FontSize="13" Foreground="#64748B" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,24" MaxWidth="400"
                                   Text="把你们的想法私信作者，有机会让作者实现你的想法哦！另外，项目的最新动态也通过这两个平台实时更新，期待你的关注！"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Douyin -->
                            <Border Grid.Column="0" Background="White" CornerRadius="16" Padding="20">
                                <StackPanel HorizontalAlignment="Center">
                                    <Image Source="Resources/QRCodes/7f09a53bd669d32db250c8ead9e924d4.jpg" Width="260" Height="260" Stretch="Uniform" Margin="0,0,0,16"/>
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#1E293B" Text="抖音"/>
                                </StackPanel>
                            </Border>

                            <!-- Bilibili -->
                            <Border Grid.Column="2" Background="White" CornerRadius="16" Padding="20">
                                <StackPanel HorizontalAlignment="Center">
                                    <Image Source="Resources/QRCodes/24aeaa7d3f01dd052ae11d91cd29eac1.jpg" Width="260" Height="260" Stretch="Uniform" Margin="0,0,0,16"/>
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#1E293B" Text="哔哩哔哩"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Note -->
                        <Border Background="#F8FAFC" CornerRadius="12" Padding="20" Margin="0,24,0,0" MaxWidth="420">
                            <TextBlock FontSize="13" Foreground="#F59E0B" TextWrapping="Wrap"
                                       Text="注：如遇到无法解决的问题，请通过以上两个平台联系作者，作者看到第一时间回复！"/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Donate -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding CurrentView, Converter={StaticResource ViewVisibilityConverter}, ConverterParameter=Donate}">
            <StackPanel Margin="28,20,28,28">
                <TextBlock FontSize="24" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,20" Text="打赏作者"/>

                <Border Style="{StaticResource Card}" Padding="32">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Background="White" CornerRadius="16" Padding="20" Margin="0,0,0,16">
                            <Image Source="Resources/Donate/596dd377-5795-4576-94f0-0d0865384f8c.png" Width="260" Height="260" Stretch="Uniform"/>
                        </Border>
                        <Border Background="#07C160" CornerRadius="6" Padding="16,6" Margin="0,0,0,24">
                            <TextBlock FontSize="13" Foreground="White" Text="微信支付"/>
                        </Border>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#1E293B" TextAlignment="Center" Margin="0,0,0,8" Text="开源不易，感谢支持"/>
                        <TextBlock FontSize="14" Foreground="#64748B" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="400"
                                   Text="如果这款软件对您有帮助，欢迎请我喝杯咖啡。您的支持是我持续更新的动力！"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
