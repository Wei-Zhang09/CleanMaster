<Window x:Class="CleanMaster.Views.AppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CleanMaster"
        Width="520" Height="Auto" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <Style x:Key="DialogPrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="24,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryDarkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogDangerBtn" TargetType="Button" BasedOn="{StaticResource DialogPrimaryBtn}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        </Style>

        <Style x:Key="DialogSecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BgSecondaryBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="24,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E8F0FE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#E6000000" CornerRadius="12" Margin="0">
        <Border CornerRadius="12" Background="{StaticResource BgPrimaryBrush}" Margin="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" Opacity="0.3" ShadowDepth="4" Color="#000000"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题栏 -->
                <Border Grid.Row="0" Background="{StaticResource SidebarBrush}" CornerRadius="12,12,0,0" Padding="20,14">
                    <DockPanel>
                        <TextBlock x:Name="TitleText" DockPanel.Dock="Left" FontSize="15" FontWeight="Bold"
                                   Foreground="White" VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Click="CloseButton_Click" VerticalAlignment="Center" Padding="4">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#86909C"/>
                        </Button>
                    </DockPanel>
                </Border>

                <!-- 正文 -->
                <Grid Grid.Row="1" Margin="24,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 图标 -->
                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" VerticalAlignment="Top" Margin="0,0,16,0"
                            x:Name="IconBadge" Background="#E8F3FF">
                        <TextBlock x:Name="IconText" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                   Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- 文字 -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" MaxHeight="340">
                        <TextBlock x:Name="MessageText" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                   TextWrapping="Wrap" LineHeight="20"/>
                    </ScrollViewer>
                </Grid>

                <!-- 按钮 -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,0,24,20">
                    <Button x:Name="CancelButton" Style="{StaticResource DialogSecondaryBtn}" Margin="0,0,10,0"
                            Content="取消" Visibility="Collapsed" Click="CancelButton_Click"/>
                    <Button x:Name="NoButton" Style="{StaticResource DialogSecondaryBtn}" Margin="0,0,10,0"
                            Content="否" Visibility="Collapsed" Click="NoButton_Click"/>
                    <Button x:Name="YesButton" Style="{StaticResource DialogPrimaryBtn}" Content="确定" Click="YesButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</Window>
