<Window x:Class="CleanMaster.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CleanMaster" Height="750" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgPrimaryBrush}"
        ResizeMode="CanResizeWithGrip"
        Icon="Resources/Icons/bebb7fbb3f23d2157e1ecc8224686535.ico">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16,20,16,28">
                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,6,0,0" Text="{Binding Lang[AppTitle]}"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top">
                    <RadioButton Style="{StaticResource NavBtn}" IsChecked="True" Command="{Binding NavigateCommand}" CommandParameter="Clean">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Lang[NavClean]}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavBtn}" Command="{Binding NavigateCommand}" CommandParameter="LargeFiles">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Lang[NavLargeFiles]}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavBtn}" Command="{Binding NavigateCommand}" CommandParameter="Software">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Lang[NavSoftware]}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavBtn}" Command="{Binding NavigateCommand}" CommandParameter="Startup">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Lang[NavStartup]}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavBtn}" Command="{Binding NavigateCommand}" CommandParameter="LargeFolders">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Lang[NavLargeFolders]}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavBtn}" Command="{Binding NavigateCommand}" CommandParameter="DiskAnalysis">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9F9;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Lang[NavDiskAnalysis]}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavBtn}" Command="{Binding NavigateCommand}" CommandParameter="SystemCleanup">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74C;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Lang[NavSystemCleanup]}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavBtn}" Command="{Binding NavigateCommand}" CommandParameter="Guide">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE82F;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Lang[NavGuide]}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavBtn}" Command="{Binding NavigateCommand}" CommandParameter="Settings">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Lang[NavSettings]}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavBtn}" Command="{Binding NavigateCommand}" CommandParameter="FollowAuthor">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Lang[NavFollowAuthor]}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavBtn}" Command="{Binding NavigateCommand}" CommandParameter="Donate">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEB51;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Lang[NavDonate]}"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- License Status (hidden - code preserved) -->
                <Border DockPanel.Dock="Bottom" Margin="12,0,12,8" Padding="12" CornerRadius="8" Background="#1E293B" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Ellipse Width="8" Height="8" Margin="0,0,6,0" Fill="#10B981"/>
                            <TextBlock FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" Text="{Binding LicenseStatusText}"/>
                        </StackPanel>
                        <Button Command="{Binding ShowActivationCommand}" Margin="0,8,0,0" HorizontalAlignment="Stretch">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#6366F1"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="Padding" Value="0,6"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="立即激活"/>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Disk Info -->
                <Border DockPanel.Dock="Bottom" Margin="12" Padding="14" CornerRadius="8" Background="#1E293B">
                    <StackPanel>
                        <TextBlock Text="C:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock FontSize="20" FontWeight="Bold" Foreground="White" Text="{Binding DiskFreeText}" Margin="0,4,0,8"/>
                        <Grid Height="5" Background="#1E293B" ClipToBounds="True">
                            <Border HorizontalAlignment="Left" Background="{StaticResource PrimaryBrush}" CornerRadius="3">
                                <Border.RenderTransform><ScaleTransform ScaleX="{Binding DiskUsedPercent}" CenterX="0"/></Border.RenderTransform>
                            </Border>
                        </Grid>
                        <TextBlock FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" Text="{Binding DiskUsageText}"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- Clean Page: 方案 C — 平滑滚动 + 滚动条常驻 -->
        <Grid Grid.Column="1"
              Visibility="{Binding CurrentView, Converter={StaticResource ViewVisibilityConverter}, ConverterParameter=Clean}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 顶部操作栏 (固定不滚动) -->
            <StackPanel Grid.Row="0" Margin="28,20,28,0">
                <Grid Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding Clean.Lang[CleanTitle]}"/>
                        <TextBlock Text="{Binding Clean.StatusText}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button Style="{StaticResource Btn}" Margin="0,0,8,0" Command="{Binding Clean.ScanCommand}" IsEnabled="{Binding Clean.CanScan}" Content="{Binding Clean.Lang[Scan]}"/>
                        <Button Style="{StaticResource SuccessBtn}" Command="{Binding Clean.CleanCommand}" IsEnabled="{Binding Clean.CanClean}" Content="{Binding Clean.Lang[Clean]}"/>
                    </StackPanel>
                </Grid>

                <!-- 进度条 (固定) -->
                <Border Height="4" CornerRadius="2" Background="{StaticResource PrimaryLightBrush}" Margin="0,0,0,12" Visibility="{Binding Clean.IsScanning, Converter={StaticResource BoolVisibilityConverter}}">
                    <Border HorizontalAlignment="Left" CornerRadius="2" Background="{StaticResource PrimaryBrush}">
                        <Border.Width><MultiBinding StringFormat="{}{0}"><Binding Path="Clean.ProgressPercent"/></MultiBinding></Border.Width>
                    </Border>
                </Border>

                <!-- 清理进度 (固定) -->
                <Border Margin="0,0,0,12" Visibility="{Binding Clean.IsCleanProgressVisible, Converter={StaticResource BoolVisibilityConverter}}">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="{Binding Lang[Cleaning]}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding Clean.CleanProgressText}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Border Height="4" CornerRadius="2" Background="{StaticResource PrimaryLightBrush}">
                            <Border HorizontalAlignment="Left" CornerRadius="2" Background="{StaticResource SuccessBrush}">
                                <Border.Width><MultiBinding StringFormat="{}{0}"><Binding Path="Clean.CleanProgressPercent"/></MultiBinding></Border.Width>
                            </Border>
                        </Border>
                        <TextBlock Text="{Binding Clean.CleanCurrentFile}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" FontWeight="Medium"/>
                        <TextBlock Text="{Binding Clean.CleanCurrentPath}" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Clean.CleanCurrentPath}"/>
                    </StackPanel>
                </Border>

                <!-- 统计卡片 (固定) -->
                <WrapPanel Margin="0,0,0,16">
                    <Border Style="{StaticResource Card}" Margin="0,0,12,0" MinWidth="140">
                        <StackPanel>
                            <TextBlock FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" Text="{Binding Clean.Lang[ItemsFound]}"/>
                            <TextBlock FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding Clean.TotalItemCount}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,12,0" MinWidth="140">
                        <StackPanel>
                            <TextBlock FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" Text="{Binding Clean.Lang[CleanableSize]}"/>
                            <TextBlock FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Text="{Binding Clean.TotalCleanableText}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" MinWidth="140">
                        <StackPanel>
                            <TextBlock FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" Text="{Binding Clean.Lang[Categories]}"/>
                            <TextBlock FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding Clean.ScanResults.Count}"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </StackPanel>

            <!-- 分类列表 CanContentScroll=False → 平滑像素滚动 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False" Padding="28,0,28,28"
                          PreviewMouseWheel="CleanPage_PreviewMouseWheel">
                <ItemsControl ItemsSource="{Binding Clean.ScanResults}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="0">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,12,0,12">
                                            <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" Text="{Binding ItemCount, StringFormat='{}{0} 项'}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Border Grid.Column="2" CornerRadius="4" Padding="8,3" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#DCFCE7"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Items[0].Safety}" Value="Caution"><Setter Property="Background" Value="#FEF9C3"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Items[0].Safety}" Value="Dangerous"><Setter Property="Background" Value="#FEE2E2"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="10" FontWeight="Medium">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="安全"/><Setter Property="Foreground" Value="#16A34A"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Items[0].Safety}" Value="Caution"><Setter Property="Text" Value="谨慎"/><Setter Property="Foreground" Value="#CA8A04"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding Items[0].Safety}" Value="Dangerous"><Setter Property="Text" Value="危险"/><Setter Property="Foreground" Value="#DC2626"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <TextBlock Grid.Column="3" Text="{Binding TotalSizeText}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <ToggleButton Grid.Column="4" IsChecked="{Binding IsExpanded}" VerticalAlignment="Center" Margin="0,0,16,0" Cursor="Hand">
                                            <ToggleButton.Style>
                                                <Style TargetType="ToggleButton">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Padding" Value="4"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ToggleButton">
                                                                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                                    <TextBlock x:Name="ArrowIcon" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsChecked" Value="True">
                                                                        <Setter TargetName="ArrowIcon" Property="Text" Value="&#xE70E;"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ToggleButton.Style>
                                        </ToggleButton>
                                    </Grid>

                                    <!-- 危险项警告条 -->
                                    <Border Visibility="{Binding HasDangerousItems, Converter={StaticResource BoolVisibilityConverter}}"
                                            Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1,0,1,1"
                                            Margin="16,0,16,8" CornerRadius="4" Padding="10,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xEA39;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#DC2626" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock FontSize="11" Foreground="#DC2626" FontWeight="Medium" Text="包含危险项：默认未选中。删除可能导致系统异常或软件损坏，请充分了解后果后再勾选。" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    <!-- 谨慎项提示条 -->
                                    <Border Visibility="{Binding HasCautionItems, Converter={StaticResource BoolVisibilityConverter}}"
                                            Background="#FFFBEB" BorderBrush="#FCD34D" BorderThickness="1,0,1,1"
                                            Margin="16,0,16,8" CornerRadius="4" Padding="10,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#CA8A04" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock FontSize="11" Foreground="#CA8A04" FontWeight="Medium" Text="包含谨慎项：删除前请确认内容，可能包含有用数据。" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 展开文件列表 CanContentScroll=False 平滑滚动 -->
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                  CanContentScroll="False" MaxHeight="240"
                                                  PreviewMouseWheel="ExpandedItem_PreviewMouseWheel"
                                                  Visibility="{Binding IsExpanded, Converter={StaticResource BoolVisibilityConverter}}"
                                                  Margin="16,0,16,12">
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,2" Background="{StaticResource BgPrimaryBrush}" Padding="8,4" CornerRadius="3">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                            <StackPanel Grid.Column="1">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                                    <TextBlock Text="⚠ 危险" FontSize="9" FontWeight="Bold" Foreground="#DC2626" Margin="6,0,0,0"
                                                                               Visibility="{Binding IsDangerous, Converter={StaticResource BoolVisibilityConverter}}"/>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding FullPath}" FontSize="9" Foreground="{StaticResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding Description}" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" MaxWidth="600" Margin="0,2,0,0"
                                                                           Visibility="{Binding Description, Converter={StaticResource NullVisibilityConverter}}"/>
                                                            </StackPanel>
                                                            <Border Grid.Column="2" CornerRadius="3" Padding="4,1" Background="{StaticResource BorderBrush}" Margin="8,0">
                                                                <TextBlock Text="{Binding SoftwareInfo}" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                            </Border>
                                                            <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 上次清理结果 (固定在底部) -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="28,0,28,28" VerticalAlignment="Bottom"
                    Visibility="{Binding Clean.LastCleanResult, Converter={StaticResource NullVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{StaticResource SuccessBrush}" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding Clean.Lang[LastCleanup]}"/>
                        <TextBlock Text="{Binding Clean.CleanResultText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
        <!-- Large Files -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding CurrentView, Converter={StaticResource ViewVisibilityConverter}, ConverterParameter=LargeFiles}">
            <StackPanel Margin="28,20,28,28">
                <Grid Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding DiskFiles.Lang[LargeFilesTitle]}"/>
                        <TextBlock Text="{Binding DiskFiles.LargeFileStatus}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <ComboBox Style="{StaticResource DriveComboBox}" ItemsSource="{Binding DiskFiles.DiskDrives}" SelectedItem="{Binding DiskFiles.SelectedDrive}" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding DiskFiles.Lang[MinSize]}" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox Style="{StaticResource InputBox}" Text="{Binding DiskFiles.MinFileSizeInput, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                        <TextBlock Text="MB" VerticalAlignment="Center" Margin="4,0,8,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <Button Style="{StaticResource Btn}" Margin="8,0,0,0" Command="{Binding DiskFiles.FindLargeFilesCommand}" IsEnabled="{Binding DiskFiles.IsFindingLargeFiles, Converter={StaticResource InverseBoolConverter}}" Content="{Binding DiskFiles.Lang[Search]}"/>
                        <Button Style="{StaticResource DangerBtn}" Margin="8,0,0,0" Command="{Binding DiskFiles.DeleteLargeFilesCommand}" Content="{Binding DiskFiles.Lang[DeleteSelected]}"/>
                    </StackPanel>
                </Grid>

                <ItemsControl ItemsSource="{Binding DiskFiles.LargeFiles}" VirtualizingStackPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="6" Padding="14,8" Margin="0,0,0,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding FileType}" FontSize="10" Foreground="#6366F1" FontWeight="Medium"/>
                                            <TextBlock Text=" | " FontSize="10" Foreground="{StaticResource TextTertiaryBrush}"/>
                                            <TextBlock Text="{Binding FileDesc}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="300"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Grid.Column="2" CornerRadius="4" Padding="6,3" Margin="8,0" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#DCFCE7"/>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding SafetyText}" FontSize="9" FontWeight="Medium">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#16A34A"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SafetyHint}" Value="caution">
                                                            <Setter Property="Foreground" Value="#CA8A04"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SafetyHint}" Value="danger">
                                                            <Setter Property="Foreground" Value="#DC2626"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <TextBlock Grid.Column="3" Text="{Binding LastModified, StringFormat='yyyy-MM-dd'}" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="4" Style="{StaticResource Btn}" Padding="10,4" FontSize="11" Margin="8,0"
                                            Command="{Binding DataContext.DiskFiles.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                            CommandParameter="{Binding FullPath}"
                                            Content="前往目录"/>
                                    <TextBlock Grid.Column="5" Text="{Binding SizeText}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" MinWidth="70" TextAlignment="Right"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Software -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding CurrentView, Converter={StaticResource ViewVisibilityConverter}, ConverterParameter=Software}">
            <StackPanel Margin="28,20,28,28">
                <Grid Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding Software.Lang[SoftwareTitle]}"/>
                        <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding Software.SoftwareStatus}"/>
                    </StackPanel>
                </Grid>

                <!-- Loading Indicator -->
                <Border Margin="0,0,0,20" Visibility="{Binding Software.IsLoadingSoftware, Converter={StaticResource BoolVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" Margin="0,40,0,0">
                        <TextBlock Text="{Binding Lang[SoftwareLoading]}" FontSize="14" Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Lang[SoftwareLoadingHint]}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Software.InstalledSoftware}" VirtualizingStackPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="6" Padding="14,10" Margin="0,0,0,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Icon -->
                                    <Image Grid.Column="0" Width="24" Height="24" Margin="0,0,12,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"
                                           Source="{Binding IconPath, Converter={StaticResource IconConverter}, IsAsync=True}"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Publisher}" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}"/>
                                            <TextBlock Text="{Binding Version}" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}" Margin="8,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding InstallLocation}" FontSize="9" Foreground="{StaticResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" Visibility="{Binding InstallLocation, Converter={StaticResource NullVisibilityConverter}}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="12,0"/>
                                    <Button Grid.Column="3" Style="{StaticResource DangerBtn}" Padding="12,5" FontSize="11" Command="{Binding DataContext.Software.UninstallCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" CommandParameter="{Binding}">
                                        <TextBlock Text="{Binding DataContext.Lang[Uninstall], RelativeSource={RelativeSource AncestorType=ScrollViewer}}"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Startup -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding CurrentView, Converter={StaticResource ViewVisibilityConverter}, ConverterParameter=Startup}">
            <StackPanel Margin="28,20,28,28">
                <Grid Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding Startup.Lang[StartupTitle]}"/>
                        <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding Startup.StatusText}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button Style="{StaticResource Btn}" Padding="12,6" FontSize="12"
                                Command="{Binding Startup.RefreshCommand}"
                                IsEnabled="{Binding Startup.IsLoading, Converter={StaticResource InverseBoolConverter}}"
                                Content="{Binding Startup.Lang[Refresh]}"/>
                    </StackPanel>
                </Grid>

                <!-- Loading Indicator -->
                <Border Margin="0,0,0,20" Visibility="{Binding Startup.IsLoading, Converter={StaticResource BoolVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" Margin="0,40,0,0">
                        <TextBlock Text="{Binding Startup.Lang[StartupLoading]}" FontSize="14" Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Startup.Lang[StartupLoadingHint]}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Startup.StartupItems}" VirtualizingStackPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="6" Padding="14,10" Margin="0,0,0,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"
                                           Source="{Binding IconPath, Converter={StaticResource IconConverter}, IsAsync=True}"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding Command}" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="450"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" CornerRadius="3" Padding="6,2" Background="#F1F5F9" VerticalAlignment="Center" Margin="12,0">
                                        <TextBlock Text="{Binding Source}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </Border>
                                    <Button Grid.Column="3" Padding="12,5" FontSize="11"
                                            Command="{Binding DataContext.Startup.ToggleStartupCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource Btn}">
                                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                                <Setter Property="Content" Value="禁用"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                        <Setter Property="Background" Value="#10B981"/>
                                                        <Setter Property="Content" Value="启用"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Large Folders -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding CurrentView, Converter={StaticResource ViewVisibilityConverter}, ConverterParameter=LargeFolders}">
            <StackPanel Margin="28,20,28,28">
                <Grid Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding Lang[LargeFoldersTitle]}"/>
                        <TextBlock Text="{Binding DiskFiles.FolderScanStatus}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <ComboBox Style="{StaticResource DriveComboBox}" ItemsSource="{Binding DiskFiles.DiskDrives}" SelectedItem="{Binding DiskFiles.SelectedDrive}" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource Btn}" Command="{Binding DiskFiles.FindLargeFoldersCommand}" IsEnabled="{Binding DiskFiles.IsScanningFolders, Converter={StaticResource InverseBoolConverter}}" Content="{Binding Lang[Scan]}"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding Lang[LargeFoldersHint]}" FontSize="13" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,16"/>
                <ItemsControl ItemsSource="{Binding DiskFiles.LargeFolders}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="6" Padding="14,10" Margin="0,0,0,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding FolderName}" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding FolderPath}" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="500"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Description}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="12,0"/>
                                    <Button Grid.Column="2" Style="{StaticResource Btn}" Padding="10,4" FontSize="11" Margin="8,0"
                                            Command="{Binding DataContext.DiskFiles.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                            CommandParameter="{Binding FolderPath}"
                                            Content="{Binding DataContext.DiskFiles.Lang[OpenFolder], RelativeSource={RelativeSource AncestorType=ScrollViewer}}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" MinWidth="80" TextAlignment="Right"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Empty Folders -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding CurrentView, Converter={StaticResource ViewVisibilityConverter}, ConverterParameter=EmptyFolders}">
            <StackPanel Margin="28,20,28,28">
                <Grid Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding Lang[EmptyFoldersTitle]}"/>
                        <TextBlock Text="{Binding DiskFiles.EmptyFolderStatus}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <ComboBox Style="{StaticResource DriveComboBox}" ItemsSource="{Binding DiskFiles.DiskDrives}" SelectedItem="{Binding DiskFiles.SelectedDrive}" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource Btn}" Margin="0,0,8,0" Command="{Binding DiskFiles.FindEmptyFoldersCommand}" IsEnabled="{Binding DiskFiles.IsScanningEmpty, Converter={StaticResource InverseBoolConverter}}" Content="{Binding Lang[Scan]}"/>
                        <Button Style="{StaticResource DangerBtn}" Command="{Binding DiskFiles.DeleteEmptyFoldersCommand}" Content="{Binding Lang[DeleteSelected]}"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding Lang[EmptyFoldersHint]}" FontSize="13" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,16"/>
                <ItemsControl ItemsSource="{Binding DiskFiles.EmptyFolders}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="6" Padding="14,10" Margin="0,0,0,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding FolderName}" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding FolderPath}" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="600"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Disk Analysis -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding CurrentView, Converter={StaticResource ViewVisibilityConverter}, ConverterParameter=DiskAnalysis}">
            <StackPanel Margin="28,20,28,28">
                <TextBlock FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" Text="{Binding Lang[DiskAnalysisTitle]}"/>
                <TextBlock Text="{Binding Settings.AnalysisStatus}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,20"/>

                <Grid Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Lang[DiskAnalysisSelectDrive]}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <ComboBox Style="{StaticResource DriveComboBox}" ItemsSource="{Binding Settings.AvailableDrives}" SelectedItem="{Binding Settings.AnalyzedDrive}" Margin="0,0,12,0"/>
                        <Button Style="{StaticResource Btn}" Padding="16,8"
                                Command="{Binding Settings.AnalyzeDiskCommand}" IsEnabled="{Binding Settings.IsAnalyzing, Converter={StaticResource InverseBoolConverter}}" Content="{Binding Lang[DiskAnalysisStart]}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding Lang[DiskAnalysisHint]}" FontSize="13" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,24"/>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <!-- Space visualization bar — dynamic: no hardcoded index binding -->
                        <ItemsControl ItemsSource="{Binding Settings.DiskSpaceCategories}" Margin="0,0,0,20">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Height="30" CornerRadius="0"
                                            Width="{Binding Percentage, Converter={StaticResource PercentToWidthConverter}}"
                                            Background="{Binding Color}"
                                            ToolTip="{Binding Name}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Category list -->
                        <ItemsControl ItemsSource="{Binding Settings.DiskSpaceCategories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="14" Height="14" Fill="{Binding Color}" Margin="0,0,10,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="14" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" Margin="16,0"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Percentage, StringFormat='{}{0:F1}%'}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Width="60" TextAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- System Cleanup -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding CurrentView, Converter={StaticResource ViewVisibilityConverter}, ConverterParameter=SystemCleanup}">
            <StackPanel Margin="28,20,28,28">
                <TextBlock FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" Text="{Binding Lang[SystemCleanupTitle]}"/>
                <TextBlock Text="{Binding SystemCleanup.CleanupStatus}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>

                <!-- Progress bar -->
                <Border Margin="0,0,0,16" Visibility="{Binding SystemCleanup.IsProgressVisible, Converter={StaticResource BoolVisibilityConverter}}">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="{Binding Lang[SystemCleanupProgressTitle]}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding SystemCleanup.ProgressText}" FontSize="12" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Border Height="8" CornerRadius="4" Background="#E2E8F0">
                            <Border HorizontalAlignment="Left" CornerRadius="4" Background="{StaticResource PrimaryBrush}">
                                <Border.Width>
                                    <MultiBinding StringFormat="{}{0}">
                                        <Binding Path="SystemCleanup.ProgressPercent"/>
                                    </MultiBinding>
                                </Border.Width>
                            </Border>
                        </Border>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding Lang[SystemCleanupHint]}" FontSize="13" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,24"/>

                <!-- DISM Cleanup -->
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Lang[SystemCleanupDismTitle]}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding Lang[SystemCleanupDismDesc]}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding Lang[SystemCleanupDismMeta]}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource Btn}" Command="{Binding SystemCleanup.RunDismCleanupCommand}" IsEnabled="{Binding SystemCleanup.IsRunningCleanup, Converter={StaticResource InverseBoolConverter}}" Content="{Binding Lang[SystemCleanupDismBtn]}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- SFC Scan -->
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Lang[SystemCleanupSfcTitle]}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding Lang[SystemCleanupSfcDesc]}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding Lang[SystemCleanupSfcMeta]}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource Btn}" Command="{Binding SystemCleanup.RunSfcScanCommand}" IsEnabled="{Binding SystemCleanup.IsRunningCleanup, Converter={StaticResource InverseBoolConverter}}" Content="{Binding Lang[SystemCleanupSfcBtn]}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- DNS Flush -->
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Lang[SystemCleanupDnsTitle]}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding Lang[SystemCleanupDnsDesc]}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding Lang[SystemCleanupDnsMeta]}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource Btn}" Command="{Binding SystemCleanup.FlushDnsCommand}" IsEnabled="{Binding SystemCleanup.IsRunningCleanup, Converter={StaticResource InverseBoolConverter}}" Content="{Binding Lang[SystemCleanupDnsBtn]}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Registry Cleaner -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding CurrentView, Converter={StaticResource ViewVisibilityConverter}, ConverterParameter=RegistryCleaner}">
            <StackPanel Margin="28,20,28,28">
                <Grid Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding Lang[RegistryCleanerTitle]}"/>
                        <TextBlock Text="{Binding RegistryCleaner.StatusText}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button Style="{StaticResource Btn}" Margin="0,0,8,0" Command="{Binding RegistryCleaner.ScanCommand}" IsEnabled="{Binding RegistryCleaner.IsScanning, Converter={StaticResource InverseBoolConverter}}" Content="{Binding Lang[Scan]}"/>
                        <Button Style="{StaticResource DangerBtn}" Command="{Binding RegistryCleaner.CleanCommand}" IsEnabled="{Binding RegistryCleaner.IsScanning, Converter={StaticResource InverseBoolConverter}}" Content="{Binding Lang[DeleteSelected]}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding Lang[RegistryCleanerHint]}" FontSize="13" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,16"/>

                <ItemsControl ItemsSource="{Binding RegistryCleaner.Issues}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="6" Padding="14,10" Margin="0,0,0,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" CornerRadius="4" Padding="6,3" Margin="0,0,12,0" Background="#FEE2E2">
                                        <TextBlock Text="{Binding Type}" FontSize="10" FontWeight="Medium" Foreground="#DC2626"/>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding Description}" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Key}" FontSize="9" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" MaxWidth="200" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Privacy Cleaner -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding CurrentView, Converter={StaticResource ViewVisibilityConverter}, ConverterParameter=PrivacyCleaner}">
            <StackPanel Margin="28,20,28,28">
                <Grid Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding Lang[PrivacyCleanerTitle]}"/>
                        <TextBlock Text="{Binding PrivacyCleaner.StatusText}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button Style="{StaticResource Btn}" Margin="0,0,8,0" Command="{Binding PrivacyCleaner.ScanCommand}" IsEnabled="{Binding PrivacyCleaner.IsScanning, Converter={StaticResource InverseBoolConverter}}" Content="{Binding Lang[Scan]}"/>
                        <Button Style="{StaticResource DangerBtn}" Command="{Binding PrivacyCleaner.CleanCommand}" IsEnabled="{Binding PrivacyCleaner.IsScanning, Converter={StaticResource InverseBoolConverter}}" Content="{Binding Lang[DeleteSelected]}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding Lang[PrivacyCleanerHint]}" FontSize="13" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,16"/>

                <ItemsControl ItemsSource="{Binding PrivacyCleaner.Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="6" Padding="14,10" Margin="0,0,0,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" CornerRadius="4" Padding="6,3" Margin="0,0,12,0" Background="#FEF9C3">
                                        <TextBlock Text="{Binding Type}" FontSize="10" FontWeight="Medium" Foreground="#CA8A04"/>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding Description}" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Path}" FontSize="9" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" MaxWidth="250" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Guide -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding CurrentView, Converter={StaticResource ViewVisibilityConverter}, ConverterParameter=Guide}">
            <StackPanel Margin="28,20,28,28" MaxWidth="700">
                <TextBlock FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,24" Text="{Binding Lang[GuideTitle]}"/>

                <!-- Safety Levels -->
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12" Text="{Binding Lang[GuideSafetyTitle]}"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="4" Padding="8,3" Background="#DCFCE7" Margin="0,0,12,0">
                                <TextBlock Text="{Binding Lang[Safe]}" FontSize="11" FontWeight="Medium" Foreground="#16A34A"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding Lang[GuideSafetySafeDesc]}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="4" Padding="8,3" Background="#FEF9C3" Margin="0,0,12,0">
                                <TextBlock Text="{Binding Lang[Caution]}" FontSize="11" FontWeight="Medium" Foreground="#CA8A04"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding Lang[GuideSafetyCautionDesc]}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="4" Padding="8,3" Background="#FEE2E2" Margin="0,0,12,0">
                                <TextBlock Text="{Binding Lang[Dangerous]}" FontSize="11" FontWeight="Medium" Foreground="#DC2626"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding Lang[GuideSafetyDangerousDesc]}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Disk Cleanup -->
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" Text="{Binding Lang[GuideCleanTitle]}"/>
                        <TextBlock Text="{Binding Lang[GuideCleanDesc]}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding Lang[GuideCleanScope]}" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding Lang[GuideCleanScopeRecycleBin]}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding Lang[GuideCleanScopeTemp]}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding Lang[GuideCleanScopeUpdate]}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding Lang[GuideCleanScopeBrowser]}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding Lang[GuideCleanScopeDev]}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding Lang[GuideCleanScopeApp]}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding Lang[GuideCleanScopeLog]}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="" FontSize="8"/>
                        <TextBlock Text="{Binding Lang[GuideCleanTip]}" FontSize="12" Foreground="#3B82F6"/>
                    </StackPanel>
                </Border>

                <!-- Large Files -->
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" Text="{Binding Lang[GuideLargeFilesTitle]}"/>
                        <TextBlock Text="{Binding Lang[GuideLargeFilesDesc]}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding Lang[GuideLargeFilesNote]}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Software Management -->
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" Text="{Binding Lang[GuideSoftwareTitle]}"/>
                        <TextBlock Text="{Binding Lang[GuideSoftwareDesc]}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding Lang[GuideSoftwareNote]}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Startup Management -->
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" Text="{Binding Lang[GuideStartupTitle]}"/>
                        <TextBlock Text="{Binding Lang[GuideStartupDesc]}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding Lang[GuideStartupNote]}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Large Folders -->
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" Text="{Binding Lang[GuideLargeFoldersTitle]}"/>
                        <TextBlock Text="{Binding Lang[GuideLargeFoldersDesc]}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding Lang[GuideLargeFoldersNote]}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Disk Analysis -->
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" Text="{Binding Lang[GuideDiskAnalysisTitle]}"/>
                        <TextBlock Text="{Binding Lang[GuideDiskAnalysisDesc]}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding Lang[GuideDiskAnalysisScope]}" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding Lang[GuideDiskAnalysisScopeWindows]}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding Lang[GuideDiskAnalysisScopeProgramFiles]}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding Lang[GuideDiskAnalysisScopeUsers]}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding Lang[GuideDiskAnalysisScopeOther]}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- System Cleanup -->
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" Text="{Binding Lang[GuideSystemCleanupTitle]}"/>
                        <TextBlock Text="{Binding Lang[GuideSystemCleanupDesc]}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding Lang[GuideSystemCleanupDism]}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding Lang[GuideSystemCleanupSfc]}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding Lang[GuideSystemCleanupDns]}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="" FontSize="8"/>
                        <TextBlock Text="{Binding Lang[SystemCleanupAdminNote]}" FontSize="12" Foreground="#F59E0B"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Settings -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding CurrentView, Converter={StaticResource ViewVisibilityConverter}, ConverterParameter=Settings}">
            <StackPanel Margin="28,20,28,28">
                <TextBlock FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,24" Text="{Binding Settings.Lang[SettingsTitle]}"/>

                <!-- Language -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16" Text="{Binding Settings.Lang[Language]}"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Margin="0,0,24,0" IsChecked="{Binding Settings.IsChinese}" GroupName="Lang">
                                <TextBlock Text="中文" FontSize="14"/>
                            </RadioButton>
                            <RadioButton IsChecked="{Binding Settings.IsChinese, Converter={StaticResource InverseBoolConverter}}" GroupName="Lang">
                                <TextBlock Text="English" FontSize="14"/>
                            </RadioButton>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Website Info -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12" Text="{Binding Settings.Lang[OfficialWebsite]}"/>
                        <TextBlock FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Text="{Binding Settings.Lang[WebsiteTip]}"/>
                    </StackPanel>
                </Border>

                <!-- WeChat Official Account -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#07C160" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding Settings.Lang[WechatOfficial]}"/>
                            <TextBlock FontSize="15" FontWeight="Bold" Foreground="#07C160" Margin="8,0,0,0" Text="{Binding Settings.Lang[WechatOfficialName]}"/>
                        </StackPanel>
                        <TextBlock FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Text="{Binding Settings.Lang[WechatOfficialTip]}"/>
                        <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0" Text="{Binding Settings.Lang[WechatOfficialGuide]}"/>
                        <TextBlock FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,8,0,0" Text="二维码见左侧「关注作者」页面"/>
                    </StackPanel>
                </Border>

                <!-- About -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12" Text="{Binding Settings.Lang[About]}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,10,0"/>
                            <TextBlock FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding Settings.Lang[AppTitle]}"/>
                        </StackPanel>
                        <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding Settings.Lang[Version]}"/>
                        <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" Text="{Binding Settings.Lang[Description]}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Follow Author -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding CurrentView, Converter={StaticResource ViewVisibilityConverter}, ConverterParameter=FollowAuthor}">
            <StackPanel Margin="28,20,28,28">
                <TextBlock FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,20" Text="{Binding Lang[FollowAuthorTitle]}"/>

                <Border Style="{StaticResource Card}" Padding="24">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextAlignment="Center" Margin="0,0,0,8" Text="{Binding Lang[FollowAuthorHeading]}"/>
                        <TextBlock FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,24" MaxWidth="400"
                                   Text="{Binding Lang[FollowAuthorDesc]}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Douyin -->
                            <Border Grid.Column="0" Background="White" CornerRadius="16" Padding="14">
                                <StackPanel HorizontalAlignment="Center">
                                    <Image Source="Resources/QRCodes/7f09a53bd669d32db250c8ead9e924d4.jpg" Width="180" Height="180" Stretch="Uniform" Margin="0,0,0,12"/>
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding Lang[FollowAuthorDouyin]}"/>
                                </StackPanel>
                            </Border>

                            <!-- Bilibili -->
                            <Border Grid.Column="2" Background="White" CornerRadius="16" Padding="14">
                                <StackPanel HorizontalAlignment="Center">
                                    <Image Source="Resources/QRCodes/24aeaa7d3f01dd052ae11d91cd29eac1.jpg" Width="180" Height="180" Stretch="Uniform" Margin="0,0,0,12"/>
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding Lang[FollowAuthorBilibili]}"/>
                                </StackPanel>
                            </Border>

                            <!-- WeChat Official Account -->
                            <Border Grid.Column="4" Background="White" CornerRadius="16" Padding="14">
                                <StackPanel HorizontalAlignment="Center">
                                    <Image Source="Resources/QRCodes/gzh.jpeg" Width="180" Height="180" Stretch="Uniform" Margin="0,0,0,12" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#07C160" Text="{Binding Lang[FollowAuthorWechat]}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Note -->
                        <Border Background="{StaticResource BgPrimaryBrush}" CornerRadius="12" Padding="20" Margin="0,24,0,0" MaxWidth="420">
                            <TextBlock FontSize="13" Foreground="#F59E0B" TextWrapping="Wrap"
                                       Text="{Binding Lang[FollowAuthorNote]}"/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Donate -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding CurrentView, Converter={StaticResource ViewVisibilityConverter}, ConverterParameter=Donate}">
            <StackPanel Margin="28,20,28,28">
                <TextBlock FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,20" Text="{Binding Lang[DonateTitle]}"/>

                <Border Style="{StaticResource Card}" Padding="32">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Background="White" CornerRadius="16" Padding="20" Margin="0,0,0,16">
                            <Image Source="Resources/Donate/596dd377-5795-4576-94f0-0d0865384f8c.png" Width="260" Height="260" Stretch="Uniform"/>
                        </Border>
                        <Border Background="#07C160" CornerRadius="6" Padding="16,6" Margin="0,0,0,24">
                            <TextBlock FontSize="13" Foreground="White" Text="{Binding Lang[DonateWechatPay]}"/>
                        </Border>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextAlignment="Center" Margin="0,0,0,8" Text="{Binding Lang[DonateHeading]}"/>
                        <TextBlock FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="400"
                                   Text="{Binding Lang[DonateDesc]}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
