<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CleanMaster.Cli</AssemblyName>
    <RootNamespace>CleanMaster.Cli</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- 与主程序共用同一套 service，但不要主程序的 requireAdministrator 清单：
         CLI 要能在 CI / 普通命令行下直接跑，扫描与预览本身不需要提权。 -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\CleanMaster.csproj" />
  </ItemGroup>

</Project>
